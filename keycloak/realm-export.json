{
  "realm": "reports-realm",
  "enabled": true,
  "accessTokenLifespan": 120,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 36000,
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyInitialCounter": 0,
  "otpPolicyDigits": 6,
  "otpPolicyLookAheadWindow": 1,
  "otpPolicyPeriod": 30,
  "otpPolicyCodeReusable": false,
  "roles": {
    "realm": [
      { "name": "user", "description": "Regular user role" },
      { "name": "administrator", "description": "Administrator role" },
      { "name": "prothetic_user", "description": "Prothetic user role with report access" }
    ]
  },
  "users": [
    {
      "username": "user1",
      "enabled": true,
      "email": "user1@example.com",
      "firstName": "User",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "password123", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "admin1",
      "enabled": true,
      "email": "admin1@example.com",
      "firstName": "Admin",
      "lastName": "One",
      "credentials": [{ "type": "password", "value": "admin123", "temporary": false }],
      "realmRoles": ["administrator"]
    }
  ],
  "clients": [
    {
      "clientId": "reports-frontend",
      "enabled": true,
      "publicClient": true,
      "redirectUris": [
        "http://localhost:3000/*",
        "http://localhost:8080/realms/reports-realm/broker/yandex/endpoint"
      ],
      "webOrigins": ["http://localhost:3000"],
      "directAccessGrantsEnabled": true,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "exclude.openid.scope": "true"
      }
    }
  ],
  "userFederationProviders": [
    {
      "id": "ldap-provider",
      "providerName": "ldap",
      "displayName": "LDAP Users",
      "priority": 0,
      "config": {
        "priority": "0",
        "importEnabled": "true",
        "editMode": "READ_ONLY",
        "syncRegistrations": "false",
        "vendor": "other",
        "usernameLDAPAttribute": "uid",
        "rdnLDAPAttribute": "uid",
        "uuidLDAPAttribute": "entryUUID",
        "userObjectClasses": "inetOrgPerson,organizationalPerson",
        "connectionUrl": "ldap://ldap:389",
        "usersDn": "ou=People,dc=bionicpro,dc=local",
        "authType": "simple",
        "bindDn": "cn=admin,dc=bionicpro,dc=local",
        "bindCredential": "admin",
        "searchScope": "1",
        "useTruststoreSpi": "never"
      }
    }
  ],
  "identityProviders": [
    {
      "alias": "yandex",
      "displayName": "Yandex ID",
      "enabled": true,
      "providerId": "oidc",
      "config": {
        "clientId": "YOUR_YANDEX_CLIENT_ID",
        "clientSecret": "YOUR_YANDEX_CLIENT_SECRET",
        "authorizationUrl": "https://oauth.yandex.ru/authorize?scope=login:email",
        "tokenUrl": "https://oauth.yandex.ru/token",
        "userInfoUrl": "https://login.yandex.ru/info",
        "logoutUrl": "https://oauth.yandex.ru/logout",
        "validateSignature": "false",
        "useJwksUrl": "false",
        "syncMode": "FORCE",
        "storeToken": "true",
        "trustEmail": "true",
        "disableNonce": "true"
      }
    }
  ],
  "identityProviderMappers": [
    {
      "name": "username",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "user.attribute": "username",
        "claim": "login"
      }
    },
    {
      "name": "email",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "user.attribute": "email",
        "claim": "default_email"
      }
    },
    {
      "name": "firstName",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "user.attribute": "firstName",
        "claim": "first_name"
      }
    },
    {
      "name": "lastName",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "user.attribute": "lastName",
        "claim": "last_name"
      }
    },
    {
      "name": "yandexId",
      "identityProviderAlias": "yandex",
      "identityProviderMapper": "oidc-user-attribute-idp-mapper",
      "config": {
        "user.attribute": "yandexId",
        "claim": "id"
      }
    }
  ],
  "authenticationFlows": [
    {
      "alias": "browser",
      "description": "browser based authentication",
      "providerId": "basic-flow",
      "topLevel": true,
      "builtIn": true,
      "authenticationExecutions": [
        {
          "authenticator": "auth-cookie",
          "requirement": "ALTERNATIVE",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-spnego",
          "requirement": "DISABLED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "identity-provider-redirector",
          "requirement": "ALTERNATIVE",
          "priority": 25,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticatorFlow": true,
          "requirement": "ALTERNATIVE",
          "priority": 30,
          "autheticatorFlow": true,
          "flowAlias": "forms"
        }
      ]
    },
    {
      "alias": "forms",
      "description": "Username, password, otp and other form based authenticators.",
      "providerId": "basic-flow",
      "topLevel": false,
      "builtIn": true,
      "authenticationExecutions": [
        {
          "authenticator": "auth-username-password-form",
          "requirement": "REQUIRED",
          "priority": 10,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        },
        {
          "authenticator": "auth-otp-form",
          "requirement": "REQUIRED",
          "priority": 20,
          "userSetupAllowed": false,
          "autheticatorFlow": false
        }
      ]
    }
  ],
  "requiredActions": [
    {
      "alias": "CONFIGURE_TOTP",
      "name": "Configure OTP",
      "providerId": "CONFIGURE_TOTP",
      "enabled": true,
      "defaultAction": true,
      "priority": 10,
      "config": {}
    }
  ]
}